# BusyBox/POSIX awk only: the standalone nginx image has no Node.js runtime.
function json(value,    result, i, ch) {
    result = "\""
    for (i = 1; i <= length(value); i++) {
        ch = substr(value, i, 1)
        if (ch in escape) result = result escape[ch]
        else result = result ch
    }
    return result "\""
}

# The origin of an http(s) URL, or "" for anything else. The result is written
# into an nginx header, so only letters, digits, dots and hyphens in the host
# and digits in the port pass; credentials, quotes or "$" leave it empty.
function origin(url,    result, next_char) {
    if (!match(url, /^https?:\/\/[A-Za-z0-9.-]+(:[0-9]+)?/)) return ""
    result = substr(url, RSTART, RLENGTH)
    next_char = substr(url, RLENGTH + 1, 1)
    if (next_char != "" && next_char != "/" && next_char != "?" && next_char != "#") return ""
    return result
}

# OPS-65: Content-Security-Policy, report-only until the reports are clean.
# Images load only from this origin and the sign-in providers' avatar hosts,
# so markdown such as ![](https://evil/?k=...) cannot send data out unasked.
# Browsers upload attachments straight to S3_ENDPOINT (presigned PUT).
function csp(    connect, api, socket, storage, policy) {
    connect = "'self'"
    api = origin(ENVIRON["KANEO_API_URL"])
    if (api != "") {
        socket = api
        sub(/^http/, "ws", socket)
        connect = connect " " api " " socket
    }
    storage = origin(ENVIRON["S3_ENDPOINT"])
    if (storage != "") connect = connect " " storage
    policy = "default-src 'self'"
    policy = policy "; script-src 'self' https://challenges.cloudflare.com"
    policy = policy "; style-src 'self' 'unsafe-inline'"
    policy = policy "; img-src 'self' data: blob: https://avatars.githubusercontent.com https://*.googleusercontent.com https://cdn.discordapp.com https://secure.gravatar.com https://gitlab.com"
    policy = policy "; font-src 'self' data:"
    policy = policy "; connect-src " connect
    policy = policy "; media-src 'self' blob:"
    policy = policy "; frame-src https://www.youtube.com https://challenges.cloudflare.com"
    policy = policy "; worker-src 'self' blob:"
    policy = policy "; manifest-src 'self'"
    # Nothing frames the app (no iframe of it in boards or infra).
    policy = policy "; frame-ancestors 'none'"
    policy = policy "; base-uri 'self'"
    policy = policy "; form-action 'self'"
    return policy "; object-src 'none'"
}

BEGIN {
    escape["\\"] = "\\\\"
    escape["\""] = "\\\""
    for (i = 1; i < 32; i++) escape[sprintf("%c", i)] = sprintf("\\u%04x", i)
    # Only these public build-time placeholders may enter browser assets.
    values["KANEO_API_URL"] = ENVIRON["KANEO_API_URL"]
    values["KANEO_CLIENT_URL"] = ENVIRON["KANEO_CLIENT_URL"]
    values["KANEO_TURNSTILE_SITE_KEY"] = ENVIRON["KANEO_TURNSTILE_SITE_KEY"]

    if (mode == "csp") {
        print "# Generated by env.sh (OPS-65)."
        print "add_header Content-Security-Policy-Report-Only \"" csp() "\" always;"
        exit
    }

    if (mode == "resource" || mode == "authorization") {
        base = values["KANEO_API_URL"]
        if (base == "") { print "{}"; exit }
        sub(/[?#].*$/, "", base)
        sub(/\/*$/, "", base)
        sub(/\/api$/, "", base)
        if (mode == "resource") {
            print "{\"resource\":" json(base "/api/mcp") ",\"authorization_servers\":[" json(base "/api") "]}"
        } else {
            print "{\"issuer\":" json(base "/api") ",\"authorization_endpoint\":" json(base "/api/mcp/authorize") ",\"token_endpoint\":" json(base "/api/mcp/token") ",\"registration_endpoint\":" json(base "/api/mcp/register") ",\"response_types_supported\":[\"code\"],\"grant_types_supported\":[\"authorization_code\"],\"code_challenge_methods_supported\":[\"S256\"],\"token_endpoint_auth_methods_supported\":[\"none\"]}"
        }
        exit
    }
}

{
    rest = $0
    output = ""
    # Match entire quoted literals. The emitted JSON string is never scanned
    # again, so a value containing another placeholder remains literal data.
    # Vite can fold a static path suffix into the same literal (for example
    # KANEO_CLIENT_URL/auth/sign-in). Only accept an unescaped static path.
    while (match(rest, /["'`]KANEO_(API_URL|CLIENT_URL|TURNSTILE_SITE_KEY)(\/[-A-Za-z0-9_.\/]*)?["'`]/)) {
        token = substr(rest, RSTART, RLENGTH)
        key = substr(token, 2, length(token) - 2)
        suffix = ""
        slash = index(key, "/")
        if (slash) { suffix = substr(key, slash); key = substr(key, 1, slash - 1) }
        output = output substr(rest, 1, RSTART - 1)
        if (substr(token, 1, 1) == substr(token, length(token), 1)) output = output json(values[key] suffix)
        else output = output token
        rest = substr(rest, RSTART + RLENGTH)
    }
    print output rest
}
